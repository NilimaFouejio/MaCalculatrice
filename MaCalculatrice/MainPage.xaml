<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MaCalculatrice.MainPage"
             Title="Calculatrice"
             BackgroundColor="#1C1C1E"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <!-- Style de base commun a toutes les touches du clavier -->
        <Style x:Key="KeyBase" TargetType="Button">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Chiffres et point decimal -->
        <Style x:Key="NumberKey" TargetType="Button" BasedOn="{StaticResource KeyBase}">
            <Setter Property="BackgroundColor" Value="#3A3A3C" />
            <Setter Property="TextColor" Value="White" />
        </Style>

        <!-- AC, effacement, changement de signe, pourcentage -->
        <Style x:Key="FunctionKey" TargetType="Button" BasedOn="{StaticResource KeyBase}">
            <Setter Property="BackgroundColor" Value="#A5A5A5" />
            <Setter Property="TextColor" Value="Black" />
        </Style>

        <!-- Operations et egal -->
        <Style x:Key="OperatorKey" TargetType="Button" BasedOn="{StaticResource KeyBase}">
            <Setter Property="BackgroundColor" Value="#FF9F0A" />
            <Setter Property="TextColor" Value="White" />
        </Style>
    </ContentPage.Resources>

    <!-- Layout racine : 3 lignes (barre, affichage, clavier) -->
    <Grid Padding="12" RowSpacing="10" RowDefinitions="Auto,Auto,*">

        <!-- Ligne 0 : barre d'information (HorizontalStackLayout) -->
        <HorizontalStackLayout Grid.Row="0" Spacing="8">
            <Label Text="Opérateur en cours :"
                   TextColor="#A0A0A0"
                   FontSize="14"
                   VerticalOptions="Center" />
            <Label x:Name="OperatorLabel"
                   Text="—"
                   TextColor="#FF9F0A"
                   FontSize="20"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>

        <!-- Ligne 1 : zone d'affichage encadree (Border + VerticalStackLayout) -->
        <Border Grid.Row="1"
                Padding="16"
                BackgroundColor="#2C2C2E"
                Stroke="#48484A"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16">
            <VerticalStackLayout Spacing="4">
                <Label x:Name="OperationLabel"
                       Text=""
                       MinimumHeightRequest="26"
                       FontSize="18"
                       TextColor="#A0A0A0"
                       HorizontalTextAlignment="End"
                       LineBreakMode="TailTruncation"
                       MaxLines="1" />
                <Label x:Name="ResultLabel"
                       Text="0"
                       FontSize="40"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="End"
                       LineBreakMode="TailTruncation"
                       MaxLines="1" />
            </VerticalStackLayout>
        </Border>

        <!-- Ligne 2 : clavier (Grid 5 lignes x 4 colonnes, parts egales) -->
        <Grid Grid.Row="2"
              RowSpacing="8"
              ColumnSpacing="8"
              RowDefinitions="*,*,*,*,*"
              ColumnDefinitions="*,*,*,*">

            <!-- Rangee 0 : AC  ⌫  %  ÷ -->
            <Button Grid.Row="0" Grid.Column="0" Text="AC" Style="{StaticResource FunctionKey}" Clicked="OnClearClicked" />
            <Button Grid.Row="0" Grid.Column="1" Text="⌫" Style="{StaticResource FunctionKey}" Clicked="OnBackspaceClicked" />
            <Button Grid.Row="0" Grid.Column="2" Text="%" Style="{StaticResource FunctionKey}" Clicked="OnPercentClicked" />
            <Button Grid.Row="0" Grid.Column="3" Text="÷" Style="{StaticResource OperatorKey}" Clicked="OnOperatorClicked" />

            <!-- Rangee 1 : 7  8  9  × -->
            <Button Grid.Row="1" Grid.Column="0" Text="7" Style="{StaticResource NumberKey}" Clicked="OnDigitClicked" />
            <Button Grid.Row="1" Grid.Column="1" Text="8" Style="{StaticResource NumberKey}" Clicked="OnDigitClicked" />
            <Button Grid.Row="1" Grid.Column="2" Text="9" Style="{StaticResource NumberKey}" Clicked="OnDigitClicked" />
            <Button Grid.Row="1" Grid.Column="3" Text="×" Style="{StaticResource OperatorKey}" Clicked="OnOperatorClicked" />

            <!-- Rangee 2 : 4  5  6  − -->
            <Button Grid.Row="2" Grid.Column="0" Text="4" Style="{StaticResource NumberKey}" Clicked="OnDigitClicked" />
            <Button Grid.Row="2" Grid.Column="1" Text="5" Style="{StaticResource NumberKey}" Clicked="OnDigitClicked" />
            <Button Grid.Row="2" Grid.Column="2" Text="6" Style="{StaticResource NumberKey}" Clicked="OnDigitClicked" />
            <Button Grid.Row="2" Grid.Column="3" Text="−" Style="{StaticResource OperatorKey}" Clicked="OnOperatorClicked" />

            <!-- Rangee 3 : 1  2  3  + -->
            <Button Grid.Row="3" Grid.Column="0" Text="1" Style="{StaticResource NumberKey}" Clicked="OnDigitClicked" />
            <Button Grid.Row="3" Grid.Column="1" Text="2" Style="{StaticResource NumberKey}" Clicked="OnDigitClicked" />
            <Button Grid.Row="3" Grid.Column="2" Text="3" Style="{StaticResource NumberKey}" Clicked="OnDigitClicked" />
            <Button Grid.Row="3" Grid.Column="3" Text="+" Style="{StaticResource OperatorKey}" Clicked="OnOperatorClicked" />

            <!-- Rangee 4 : ±  0  .  = -->
            <Button Grid.Row="4" Grid.Column="0" Text="±" Style="{StaticResource FunctionKey}" Clicked="OnSignClicked" />
            <Button Grid.Row="4" Grid.Column="1" Text="0" Style="{StaticResource NumberKey}" Clicked="OnDigitClicked" />
            <Button Grid.Row="4" Grid.Column="2" Text="." Style="{StaticResource NumberKey}" Clicked="OnDecimalClicked" />
            <Button Grid.Row="4" Grid.Column="3" Text="=" Style="{StaticResource OperatorKey}" Clicked="OnEqualsClicked" />
        </Grid>
    </Grid>
</ContentPage>
